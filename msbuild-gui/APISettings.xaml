<Window
    x:Class="msbuild_gui.APISettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:msbuild_gui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:msbuild_gui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:msbuild_gui.Properties"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="{Binding Resources.OpenAIAPISetting, Source={x:Static app:ResourceService.Current}, Mode=OneWay}"
    Width="370"
    Height="480"
    ui:WindowHelper.UseModernWindowStyle="True"
    Closing="Window_Closing"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Margin="10,0,10,0">
            <Label HorizontalAlignment="Left" Content="Provider" />
            <ComboBox
                x:Name="ProviderComboBox"
                Width="160"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                SelectionChanged="ProviderComboBox_SelectionChanged">
                <ComboBoxItem Content="OpenAI" />
                <ComboBoxItem Content="Azure" />
                <ComboBoxItem Content="GitHubCopilot" />
            </ComboBox>

            <!-- OpenAI / Azure 用 API Key -->
            <Label x:Name="APIKeyLabel" HorizontalAlignment="Left" Content="API Key" />
            <PasswordBox
                x:Name="APIKeyPasswordbox"
                MinWidth="200"
                VerticalAlignment="Top"
                PasswordChar="*">
                <PasswordBox.Background>
                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource SystemChromeLowColor}" />
                </PasswordBox.Background>
            </PasswordBox>

            <!-- GitHub Copilot 用サインインパネル -->
            <StackPanel x:Name="GitHubSignInPanel" Visibility="Collapsed" Margin="0,4,0,4">
                <Label HorizontalAlignment="Left" Content="GitHub Copilot" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="GitHubStatusText"
                    Margin="0,2,0,6"
                    Foreground="{DynamicResource SystemBaseHighColorBrush}"
                    Text="GitHub アカウントでサインインしてください。"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="GitHubSignInButton"
                    Width="180"
                    HorizontalAlignment="Left"
                    Click="GitHubSignInButton_Click"
                    Content="Sign in with GitHub" />
                <!-- デバイスフロー認証コード表示パネル -->
                <Border
                    x:Name="DeviceCodePanel"
                    Margin="0,8,0,0"
                    Padding="8"
                    BorderBrush="{DynamicResource SystemBaseLowColorBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="ブラウザが開きます。以下のコードを入力してください:" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DeviceCodeText"
                            Margin="0,4,0,0"
                            FontFamily="Consolas"
                            FontSize="20"
                            FontWeight="Bold"
                            HorizontalAlignment="Center" />
                        <Button
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Click="CopyCodeButton_Click"
                            Content="コードをコピー"
                            Width="120" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Label HorizontalAlignment="Left" Content="Model" />
            <ComboBox
                x:Name="ModelComboBox"
                MinWidth="200"
                IsEditable="True"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />
            <Label x:Name="DeploymentIdLabel" HorizontalAlignment="Left" Content="Deployment-ID" />
            <TextBox
                x:Name="DeploymentIdTextbox"
                MinWidth="200"
                VerticalAlignment="Top">
                <TextBox.Background>
                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource SystemChromeLowColor}" />
                </TextBox.Background>
            </TextBox>
            <Label x:Name="BaseDomainLabel" HorizontalAlignment="Left" Content="BaseDomain" />
            <TextBox
                x:Name="BaseDomainTextbox"
                MinWidth="200"
                VerticalAlignment="Top"
                ui:ControlHelper.PlaceholderText="">
                <TextBox.Background>
                    <SolidColorBrush Opacity="0.5" Color="{DynamicResource SystemChromeLowColor}" />
                </TextBox.Background>
            </TextBox>
        </StackPanel>
        <Button
            x:Name="OkButton"
            Grid.Row="2"
            Width="120"
            Height="30"
            MinWidth="60"
            Margin="0,0,10,10"
            Padding="0,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="OkButton_Click"
            Content="_OK"
            IsDefault="True"
            Style="{StaticResource AccentButtonStyle}" />
    </Grid>
</Window>
